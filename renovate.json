{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		":semanticCommits",
		":separateMultipleMajorReleases"
	],
	"schedule": ["before 6am on monday"],
	"timezone": "America/New_York",
	"labels": ["dependencies"],
	"prConcurrentLimit": 10,
	"prHourlyLimit": 0,
	"rangeStrategy": "bump",
	"automergeStrategy": "squash",
	"minimumReleaseAge": "3 days",
	"separateMinorPatch": true,
	"lockFileMaintenance": {
		"enabled": true,
		"schedule": ["before 6am on monday"],
		"automerge": true
	},
	"customManagers": [
		{
			"customType": "regex",
			"description": "Keep biome.json $schema on the same version as @biomejs/biome",
			"managerFilePatterns": ["/(^|/)biome\\.json$/"],
			"matchStrings": [
				"\"\\$schema\"\\s*:\\s*\"https://biomejs\\.dev/schemas/(?<currentValue>[^/\"]+)/schema\\.json\""
			],
			"datasourceTemplate": "npm",
			"depNameTemplate": "@biomejs/biome"
		}
	],
	"packageRules": [
		{
			"matchManagers": ["npm", "custom.regex"],
			"matchUpdateTypes": ["minor"],
			"groupName": "npm dependencies (minor)",
			"groupSlug": "npm-minor",
			"automerge": true
		},
		{
			"matchManagers": ["npm", "custom.regex"],
			"matchUpdateTypes": ["patch"],
			"groupName": "npm dependencies (patch)",
			"groupSlug": "npm-patch",
			"schedule": ["at any time"],
			"automerge": true
		},
		{
			"matchManagers": ["github-actions"],
			"groupName": "GitHub Actions",
			"separateMultipleMajor": false,
			"separateMajorMinor": false,
			"automerge": true
		}
	],
	"vulnerabilityAlerts": {
		"labels": ["security"],
		"schedule": ["at any time"],
		"rangeStrategy": "bump",
		"automerge": true,
		"minimumReleaseAge": "0 days"
	}
}
